# EMONI main board EHW0014-0011 as a kibbl. feeder (ESP32-S3-WROOM-1-N16R8: octal PSRAM,
# 16 MB flash; the partition table uses the first 4 MB). Built with
# -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.emoni" and its own sdkconfig
CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_KIBBL_BOARD_FREENOVE_S3 is not set
CONFIG_KIBBL_BOARD_EMONI=y
