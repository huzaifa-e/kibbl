# Copy to .env next to docker-compose.yml (or backend/.env for development) and fill in.

# signs the login cookies; at least 32 random characters: openssl rand -hex 32
JWT_SECRET=

# database users, created on the first start of an empty database; the passwords are
# generated by deploy/deploy.sh (hex, so they fit in a connection string as they are)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=kibbl
MONGO_APP_PASSWORD=

# the first account, created on the first start only. ADMIN_EMAIL is also the admin from then
# on: approves devices that connected without a USB setup, sees the setup guide of Health
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# anybody can create an account on the login page (each sees only their own devices,
# meters and health); closed: only the admin's account
# SIGNUP=closed

# the address people open the app at: the links of password reset mails point here
APP_URL=
# the SMTP account that sends those mails; without SMTP_HOST and APP_URL passwords cannot be reset
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   for port 465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# the server as the devices reach it: firmware downloads, and (as ws:// or wss://)
# the address the app writes into a device it sets up over USB
DEVICE_BASE_URL=http://10.0.1.99:8790
# DEVICE_SOCKET_URL=wss://home.example.com/device/socket   only when it differs from DEVICE_BASE_URL

# true when the app is served over https (tunnel or reverse proxy)
COOKIE_SECURE=false

# days motion snapshots are kept
RETENTION_DAYS=14

# what the server logs: debug | info | warn | error (info by default; debug adds unknown device messages)
LOG_LEVEL=info

# Health: an OAuth client (Web application) of a Google Cloud project with the Google Health
# API enabled; docs/deployment.md, Health. Without them the health page says it is not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# the Google Cloud project of the app: the access requests link straight to its Test users page
# GOOGLE_PROJECT_ID=kibbl-123456
# true once the Google app is published: no tester list, no 7-day access; the guides say so
# GOOGLE_APP_PUBLISHED=true
# where Google sends the user back; by default this server as the browser reaches it:
# GOOGLE_REDIRECT_URI=https://home.example.com/api/health/google/callback
# encrypts the stored Google tokens; derived from JWT_SECRET when empty
# HEALTH_TOKEN_KEY=
# requests to Google Health under way at once, for all users (4 by default); lower it on a small server
# HEALTH_CONCURRENCY=4

# Meters: read from the EMONI LoRaWAN server (ttn-chirpstack-webhook) on the same host.
# METERS: uuids of its configured devices, added on start (more can be added in the app)
METERS=
# METER_SOURCE_URL=http://emoni-lorawan:8000
# METER_SOURCE_NETWORK=ttn-chirpstack-webhook_default   its docker network, joined by the app

# kibbl. air: the weather outside the home for the climate hints (Open-Meteo, free). Each account
# chooses its home in Settings; these stand in for an account that has not
# OpenWeather instead of Open-Meteo (stations rather than models; free key at openweathermap.org)
# OPENWEATHER_API_KEY=
# HOME_LATITUDE=50.11
# HOME_LONGITUDE=8.68
# alerts (window open, fire, the room too cold or hot) go by e-mail (SMTP above) and, with a
# topic here, as push messages through ntfy (the ntfy app on the phone subscribes to it)
# NTFY_URL=https://ntfy.sh/<a long random topic>
# NTFY_TOKEN=          for a protected topic or an own ntfy server

# Visits (core/visits.ts): a camera with "E-mail me when something comes" sends one mail a
# visit, at the feeder only when the cat detector (YOLOX-S, run on the server) sees a cat. The
# image brings the model; elsewhere point to it (without it every movement is a visit).
# CAT_MODEL_PATH=/home/node/models/yolox_s.onnx

# MCP endpoint for AI assistants: its public https address and the assistants' OAuth callbacks
# (docs/deployment.md, MCP)
# MCP_PUBLIC_URL=https://kibbl.<tailnet>.ts.net
# MCP_REDIRECT_URIS=https://assistant.example/callback

# token of the Cloudflare named tunnel, for the compose service `cloudflare` (docs/deployment.md)
# CLOUDFLARE_TUNNEL_TOKEN=

# frames per second while someone watches (the camera allows up to 30), and for motion detection
STREAM_FPS=30
MOTION_FPS=2

# set by docker-compose.yml; needed when running the backend without docker
# PORT=8790
# MONGODB_URI=mongodb://127.0.0.1:27017/kibbl     (a local database without users)
# IMAGE_DATA_PATH=./data/images
# FIRMWARE_DATA_PATH=./data/firmware
