{
    "id": "/gym",
    "name": "kibbl. gym",
    "short_name": "Gym",
    "description": "Every workout in one place: sets and weights, runs, rides, Pilates, and how each muscle progresses.",
    "start_url": "/gym",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#f3e6cf",
